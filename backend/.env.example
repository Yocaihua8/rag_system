# Knowledge Island backend environment template.
# Copy this file to backend/.env. Never commit secrets or the resulting .env.
# General settings precedence: OS environment > application data .env > backend/.env > defaults.
# CORS and authentication settings use OS environment > backend/.env > defaults.

# Runtime data remains rooted at repository-root runtime/v2 by default.
# RAG_RUNTIME_DIR=./runtime/v2
# RAG_KB_ROOT=~/KnowledgeIslandKB
# KI_API_HOST=127.0.0.1
# KI_API_PORT=8765

# Browser and desktop origins allowed to call the API.
# Values are comma-separated explicit origins; wildcards are rejected.
# KI_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5174,http://localhost:5174,http://127.0.0.1:4173,http://localhost:4173,http://127.0.0.1:4174,http://localhost:4174,tauri://localhost,http://tauri.localhost

# Optional API authentication.
# RAG_AUTH_ENABLED=0
# RAG_AUTH_API_KEY=replace-with-a-random-local-secret
# RAG_AUTH_JWT_SECRET=replace-with-a-different-random-secret
# RAG_AUTH_JWT_TTL_SECONDS=3600

# Ollama.
# RAG_OLLAMA_HOST=http://localhost:11434
# RAG_OLLAMA_MODEL=qwen2.5:7b
# RAG_EMBEDDING_MODEL=nomic-embed-text
# RAG_EMBEDDING_DIM=768

# Retrieval.
# RAG_RETRIEVER_KIND=vector
# RAG_CHUNK_SIZE=512
# RAG_CHUNK_OVERLAP=64
# RAG_TOP_K=8
# RAG_VECTOR_STORE_PROVIDER=qdrant
# RAG_QDRANT_PATH=./runtime/v2/qdrant
# RAG_QDRANT_COLLECTION=knowledge_island_chunks
# RAG_QDRANT_VECTOR_SIZE=96
# RAG_RERANKER_ENABLED=false
# RAG_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# OpenAI-compatible embedding endpoint.
# RAG_EMBED_PROVIDER=api
# RAG_EMBED_API_BASE=https://api.openai.com/v1
# RAG_EMBED_API_MODEL=text-embedding-3-small
# RAG_EMBED_API_KEY=replace-with-your-key

# OpenAI-compatible LLM endpoint.
# RAG_LLM_TEMPERATURE=0.7
# RAG_LLM_MAX_TOKENS=2048
# RAG_LLM_PROVIDER=api
# RAG_LLM_API_BASE=https://api.deepseek.com/v1
# RAG_LLM_API_MODEL=deepseek-chat
# RAG_LLM_API_KEY=replace-with-your-key
