# Copy to ops/docker/.env and set only the values you need.
# Never commit real API keys.

KI_API_PORT=8765
KI_WEB_PORT=4173
KI_PUBLIC_API_URL=http://127.0.0.1:8765
KI_CORS_ORIGINS=http://127.0.0.1:4173,http://localhost:4173
KNOWLEDGE_ISLAND_WORKSPACE=../../docker-workspace

RAG_LLM_PROVIDER=api
RAG_LLM_API_BASE=https://api.deepseek.com/v1
RAG_LLM_API_MODEL=deepseek-chat
RAG_LLM_API_KEY=
DEEPSEEK_API_KEY=

RAG_EMBED_PROVIDER=
RAG_EMBED_API_BASE=
RAG_EMBED_API_MODEL=
RAG_EMBED_API_KEY=

RAG_AUTH_ENABLED=false
RAG_AUTH_API_KEY=
RAG_AUTH_JWT_SECRET=
